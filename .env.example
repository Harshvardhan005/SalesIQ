# SalesIQ Environment Configuration
FLASK_APP=app.py
FLASK_ENV=development
DEBUG=True
PORT=5000
DATABASE_URI=salesiq.db
SECRET_KEY=salesiq_super_secret_key_2026
GROQ_API_KEY=your_groq_api_key_here

# ──────────────────────────────────────────────
# Search API Integrations (optional — add any key to enable that provider)
# Priority order when website scraping fails: Tavily → Serper → Google CSE → Bing
# ──────────────────────────────────────────────

# 1. Tavily (recommended — optimised for AI agents, returns clean summaries)
#    Get key: https://app.tavily.com
TAVILY_API_KEY=

# 2. Serper (Google results via serper.dev — generous free tier)
#    Get key: https://serper.dev
SERPER_API_KEY=

# 3. Google Custom Search Engine
#    Create CSE: https://programmablesearchengine.google.com
#    Get API key: https://console.cloud.google.com → Custom Search JSON API
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# 4. Bing Web Search (Azure Cognitive Services)
#    Get key: https://portal.azure.com → Bing Search resource
BING_SEARCH_API_KEY=
